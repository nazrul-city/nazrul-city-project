# -----------------------------------------------------------------------------
# Database (PostgreSQL) — Prisma ORM 7
# -----------------------------------------------------------------------------
# Put this in `.env` (Prisma CLI + dotenv) and optionally `.env.local` (Next.js).
# Render external URL: use sslmode=verify-full.
# node-pg currently treats sslmode=require as verify-full, and warns about that.
# The next pg major version will make require weaker. verify-full keeps the
# strict certificate check and removes the warning.
# On Vercel / CI: set the same name as a project env var (no .env file needed).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# -----------------------------------------------------------------------------
# Logging (Pino)
# -----------------------------------------------------------------------------
# fatal | error | warn | info
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Sentry Observability Configuration
# -----------------------------------------------------------------------------
# Public DSN for client-side browser error reporting
# Found in: Sentry -> Project Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
# DSN for server & edge runtime error reporting (falls back to NEXT_PUBLIC_SENTRY_DSN if unset)
SENTRY_DSN=""
# Sentry Organization & Project slugs (used for sourcemap release tracking)
# Found in: Sentry Organization Settings & Project Settings
SENTRY_ORG=""
SENTRY_PROJECT=""
# Sentry Authentication Token (used in CI/CD for uploading sourcemaps)
# Generated in: Sentry -> User Settings -> API -> Auth Tokens (needs project:releases scope)
SENTRY_AUTH_TOKEN=""

# -----------------------------------------------------------------------------
# Admin login
# -----------------------------------------------------------------------------
# AUTH_SECRET signs the admin session cookie. Use at least 32 random characters.
# The first login creates a super admin from ADMIN_EMAIL and ADMIN_PASSWORD
# when the users table is empty. The password is stored only as a scrypt hash.
AUTH_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"

# -----------------------------------------------------------------------------
# Cloudinary image upload
# -----------------------------------------------------------------------------
# The browser uploads plot and flat images with an unsigned upload preset.
# Leave these empty until the Cloudinary account exists. The rest of the site
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# Cloudinary server-side credentials for deleting images (from Cloudinary dashboard)
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
