# -----------------------------------------------------------------------------
# Database (PostgreSQL) — Prisma ORM 7
# -----------------------------------------------------------------------------
# Put this in `.env` (Prisma CLI + dotenv) and optionally `.env.local` (Next.js).
# Render external URL: always include sslmode=require.
# On Vercel / CI: set the same name as a project env var (no .env file needed).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# -----------------------------------------------------------------------------
# Logging (Pino)
# -----------------------------------------------------------------------------
# fatal | error | warn | info
LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# Sentry Observability Configuration
# -----------------------------------------------------------------------------
# Public DSN for client-side browser error reporting
# Found in: Sentry -> Project Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=""
# DSN for server & edge runtime error reporting (falls back to NEXT_PUBLIC_SENTRY_DSN if unset)
SENTRY_DSN=""
# Sentry Organization & Project slugs (used for sourcemap release tracking)
# Found in: Sentry Organization Settings & Project Settings
SENTRY_ORG=""
SENTRY_PROJECT=""
# Sentry Authentication Token (used in CI/CD for uploading sourcemaps)
# Generated in: Sentry -> User Settings -> API -> Auth Tokens (needs project:releases scope)
SENTRY_AUTH_TOKEN=""